{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript"],
  "rules": {
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "no-console": "error"
      }
    },
    {
      "files": ["scripts/**/*.mjs"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}

