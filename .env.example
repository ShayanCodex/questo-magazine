# Google Cloud Translation API Key (used by scripts/translate.mjs; NEVER prefix with VITE_)
GOOGLE_TRANSLATE_API_KEY=

# GitHub repo info for "Edit this article on GitHub" links (optional)
VITE_GITHUB_REPO=
VITE_GITHUB_BRANCH=main

# Giscus Comments Configuration (Powered by GitHub Discussions - Free, zero server, no database needed)
# Generate your repository IDs at https://giscus.app
VITE_GISCUS_REPO=
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY=Announcements
VITE_GISCUS_CATEGORY_ID=

