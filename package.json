{
  "name": "questo",
  "version": "1.0.0",
  "description": "Questo: a static, multilingual, GitHub-powered editorial blog",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint:oxlint": "oxlint",
    "lint:eslint": "eslint .",
    "lint": "oxlint && eslint .",
    "typecheck": "tsc --noEmit",
    "validate-content": "node scripts/validate-content.mjs",
    "translate": "node scripts/translate.mjs",
    "ssg:build": "vite-react-ssg build",
    "postbuild": "node scripts/postbuild.mjs",
    "build": "npm run lint && npm run typecheck && npm run validate-content && npm run ssg:build && npm run postbuild",
    "preview": "vite preview",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run validate-content"
  },
  "keywords": [
    "blog",
    "static-site-generator",
    "ssg",
    "multilingual",
    "vite",
    "react19",
    "editorial"
  ],
  "author": "Questo Editorial",
  "license": "MIT",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^3.7.0",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "^1.92.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "oxlint": "^1.92.0",
    "puppeteer": "^25.16.0",
    "puppeteer-core": "^25.16.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7"
  }
}
